APP_NAME="V2free Secure Platform API"
ENVIRONMENT="production"
DEBUG=false
API_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://v2free_app:replace-with-strong-password@10.0.0.5:5432/v2free"
JWT_SECRET_KEY="replace-with-a-random-32-byte-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUSTED_HOSTS="api.example.com,localhost,127.0.0.1"
CORS_ORIGINS="https://x.aziz-x.com,https://admin.example.com"
ENFORCE_HTTPS_REDIRECT=true
CONTENT_ENCRYPTION_KEY="replace-with-fernet-key-from-python-c-print"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
